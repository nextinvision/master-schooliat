# Backend Environment Variables
# Copy this file to .env for local development

# Environment
NODE_ENV=development
# Port 4000 matches dashboard's Next.js proxy (next.config.js). Use 3000 if not using the dashboard proxy.
PORT=4000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/schooliat_dev
DATABASE_DIRECT_URL=postgresql://user:password@localhost:5432/schooliat_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_this
JWT_EXPIRATION_TIME=48

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3003,http://localhost:3000

# File storage: "local" (filesystem), "minio" (local MinIO), "aws-s3" (AWS cloud)
# For locally installed MinIO (recommended): use FILE_STORAGE=minio and set below.
FILE_STORAGE=minio
MINIO_ENDPOINT=http://localhost:9000
AWS_S3_BUCKET=schooliat-files
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123

# Logging
LOG_LEVEL=debug

# --- Outbound email (Nodemailer) — OTP, password reset, school/employee welcome mail ----------
# Your screenshots are DNS only (MX, SPF, DKIM, DMARC, autodiscover). Those records stay in GoDaddy;
# the API only needs SMTP credentials below to send mail.
#
# GoDaddy Email & Office / workspace — typical outgoing server (not the MX host from DNS tables):
#   SMTP_HOST=smtpout.secureserver.net
#   Port 465 + SSL:
#     SMTP_PORT=465
#     SMTP_SECURE=true
#   Or port 587 + STARTTLS (defaults work: secure=false, requireTLS on 587):
#     SMTP_PORT=587
#     SMTP_SECURE=false
#
# If your plan is Microsoft 365 through GoDaddy, often:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# SMTP_USER = full mailbox address (e.g. noreply@yourdomain.com)
# SMTP_PASSWORD = that mailbox password (or app password if enforced)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional: log SMTP handshake issues at boot (does not stop the server if it fails)
# SMTP_VERIFY_ON_START=true
# SMTP_CONNECTION_TIMEOUT_MS=60000
# SMTP_REQUIRE_TLS=true
# Dev only if you hit TLS chain issues: SMTP_TLS_REJECT_UNAUTHORIZED=false

# Encrypt SMTP passwords saved from Super Admin → Settings (AES-256-GCM). Required to use UI password save.
# Use a long random string; same key must persist across deploys or stored passwords become unreadable.
# PLATFORM_EMAIL_ENCRYPTION_KEY=
